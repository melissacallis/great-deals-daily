# Copy this file to .env and fill in your values.
# Get credentials in Associates Central > Tools > Creators API.

AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# The "Version" shown next to your credential (e.g. 3.1 for US, 3.2 for EU, 3.3 for JP; older keys use 2.x)
AMAZON_CREDENTIAL_VERSION=3.1
# Your Associates tracking ID, e.g. yourname-20
AMAZON_PARTNER_TAG=
# Marketplace host, e.g. www.amazon.com, www.amazon.co.uk, www.amazon.de
AMAZON_MARKETPLACE=www.amazon.com

SITE_NAME=Great Deals Daily
PORT=3000
# How long to cache results before asking Amazon again
CACHE_MINUTES=60
